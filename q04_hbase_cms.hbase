# Q4: Content Management System
create 'CMS', 'content', 'author', 'metadata'
put 'CMS', 'C001', 'content:title', 'HBase Basics'
put 'CMS', 'C001', 'content:body', 'Introduction to HBase'
put 'CMS', 'C001', 'author:name', 'Aman'
put 'CMS', 'C001', 'metadata:status', 'DRAFT'
put 'CMS', 'C001', 'metadata:version', '1'
# Update content and status
put 'CMS', 'C001', 'content:body', 'Introduction to HBase and column families'
put 'CMS', 'C001', 'metadata:status', 'PUBLISHED'
get 'CMS', 'C001'
scan 'CMS'
# Delete one cell or the full row
delete 'CMS', 'C001', 'content:body'
